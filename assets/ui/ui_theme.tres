[gd_resource type="Theme" format=3]

; Bundled font option: add a FontFile ext_resource pointing to
; res://assets/ui/fonts/BeVietnamPro-Regular.ttf, and use it as default_font.
[sub_resource type="SystemFont" id="VietnameseFont"]
font_names = PackedStringArray("Be Vietnam Pro", "Noto Sans", "Segoe UI", "Arial")

[sub_resource type="StyleBoxFlat" id="Panel"]
content_margin_left = 8.0
content_margin_top = 8.0
content_margin_right = 8.0
content_margin_bottom = 8.0
bg_color = Color(0.12, 0.17, 0.15, 0.98)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.35, 0.44, 0.36, 1)
corner_radius_top_left = 10
corner_radius_top_right = 10
corner_radius_bottom_left = 10
corner_radius_bottom_right = 10

[sub_resource type="StyleBoxFlat" id="TabContent"]
content_margin_left = 14.0
content_margin_top = 16.0
content_margin_right = 14.0
content_margin_bottom = 14.0
bg_color = Color(0.09, 0.13, 0.11, 1)
corner_radius_bottom_left = 6
corner_radius_bottom_right = 6

[sub_resource type="StyleBoxFlat" id="Button"]
content_margin_left = 12.0
content_margin_top = 9.0
content_margin_right = 12.0
content_margin_bottom = 9.0
bg_color = Color(0.23, 0.33, 0.26, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_left = 6
corner_radius_bottom_right = 6

[sub_resource type="StyleBoxFlat" id="Hover"]
content_margin_left = 12.0
content_margin_top = 9.0
content_margin_right = 12.0
content_margin_bottom = 9.0
bg_color = Color(0.32, 0.44, 0.34, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_left = 6
corner_radius_bottom_right = 6

[sub_resource type="StyleBoxFlat" id="Pressed"]
content_margin_left = 12.0
content_margin_top = 9.0
content_margin_right = 12.0
content_margin_bottom = 9.0
bg_color = Color(0.16, 0.25, 0.19, 1)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_left = 6
corner_radius_bottom_right = 6

[resource]
default_font = SubResource("VietnameseFont")
default_font_size = 16
Label/font_sizes/font_size = 16
Button/font_sizes/font_size = 16
OptionButton/font_sizes/font_size = 16
PopupMenu/font_sizes/font_size = 16
TabBar/font_sizes/font_size = 18
TabContainer/font_sizes/font_size = 18
Window/font_sizes/title_font_size = 20
Heading/base_type = &"Label"
Heading/font_sizes/font_size = 30
Label/colors/font_color = Color(0.95, 0.96, 0.91, 1)
Label/constants/line_spacing = 4
PanelContainer/styles/panel = SubResource("Panel")
Button/styles/normal = SubResource("Button")
Button/styles/hover = SubResource("Hover")
Button/styles/pressed = SubResource("Pressed")
OptionButton/styles/normal = SubResource("Button")
OptionButton/styles/hover = SubResource("Hover")
OptionButton/styles/pressed = SubResource("Pressed")
TabContainer/styles/panel = SubResource("TabContent")
TabContainer/styles/tab_selected = SubResource("Hover")
TabContainer/styles/tab_unselected = SubResource("Button")
TabContainer/styles/tab_hovered = SubResource("Hover")
TabBar/styles/tab_selected = SubResource("Hover")
TabBar/styles/tab_unselected = SubResource("Button")
TabBar/styles/tab_hovered = SubResource("Hover")
